{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.sf/**)",
      "Edit(./.sf/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "WebFetch",
      "WebSearch"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": ["./.sf"]
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
